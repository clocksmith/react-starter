{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist/types",
    "emitDeclarationOnly": true,
    "declaration": true,
    "types": []
  },
  "include": ["src"],
  "references": [{ "path": "../packages/core" }, { "path": "../packages/ui" }]
}
