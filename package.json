{
  "name": "react-starter",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/ui",
    "example"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "boundaries": "node tool/check_boundaries.mjs",
    "test": "vitest run",
    "verify:consumer": "node tool/verify_consumer.mjs",
    "check": "bash tool/check.sh",
    "dev": "npm run build && npm run dev --workspace example"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
